# copy to .env and fill in. NEVER commit .env
DOMAIN=academic            # academic|legal|agriculture|health|support|hr|contracts|tourism|grants|cyber|generic
LLM_PROVIDER=gemini        # gemini (free tier) | groq (free, open models) | ollama (local) | offline
LLM_MODEL=gemini-3.8-flash       # groq: qwen/qwen3.8-27b
LLM_FAST_MODEL=gemini-3.8-flash  # groq: llama-3.1-8b-instant
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDER=auto              # auto|local|openai|gemini|tfidf
RETRIEVAL_MODE=hybrid      # bm25|dense|hybrid
TOP_K=5
MAX_TOKENS=2048            # newer Gemini models think first; thinking counts toward this
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RERANK=none                # none|llm|cross
SECRET_KEY=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too
